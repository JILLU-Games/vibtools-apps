# GitHub Personal Access Token (optional, for private repositories)
GITHUB_TOKEN=

# Enable mock catalog & demo installer fallback on production custom domains ("true" or "false")
# Defaults to enabled on localhost / *.pages.dev previews and disabled on live production domains
ENABLE_MOCK_FALLBACK=

# Optional comma-separated extra trusted HTTPS download hosts for /dl/ 302 redirects
# Default allowlist always includes: dl.vib.tools, github.com, objects.githubusercontent.com, release-assets.githubusercontent.com
ALLOWED_DOWNLOAD_HOSTS=

